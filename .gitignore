################
# gradle files #
################
/build
/.gradle
/out
# Ignore Gradle GUI config
gradle-app.setting
# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties
# Cache of project
.gradletasknamecache
# # Work around https://youtrack.jetbrains.com/issue/IDEA-116898
# gradle/wrapper/gradle-wrapper.properties

##############################################################
# virtual machine crash logs                                 #
# see http://www.java.com/en/download/help/error_hotspot.xml #
##############################################################
hs_err_pid*
/.attach_pid*

##############################################################
# Output of file based tests                                  #
#                                                             #
# A few file based tests still write next to their fixtures   #
# under src/test/resources instead of into a @TempDir and     #
# clean up afterwards. When PIT kills a forked JVM before      #
# that cleanup runs, the files stay behind - ignoring them     #
# keeps a stray "git add -A" from committing build output.     #
# See docs/TESTING.md, "Known issues in the test setup".       #
##############################################################
/src/test/resources/crypt/*.enc
/src/test/resources/der/keystore.jks
